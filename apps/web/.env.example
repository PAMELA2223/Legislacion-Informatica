# Supabase (plan gratuito) - obtener en https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service Role Key (OPCIONAL pero recomendada) - misma pagina que el anon key,
# seccion "service_role". NUNCA la expongas al navegador (por eso no lleva
# el prefijo NEXT_PUBLIC_). Se usa SOLO en el servidor para que, cuando un
# administrador cambia el rol de un usuario desde /admin/usuarios, ese
# cambio tambien se sincronice con el metadata de Supabase Auth (el JWT de
# sesion). Sin esta key, el cambio de rol igual funciona dentro de la app
# (Prisma es la fuente de verdad), pero puede tardar hasta que el usuario
# vuelva a iniciar sesion para que TODO quede consistente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Prisma - cadenas de conexion de PostgreSQL
# Obtener en: Supabase -> Settings -> Database -> Connection string
#
# IMPORTANTE: la conexion DIRECTA (db.<ref>.supabase.co:5432) solo funciona
# por IPv6. Si tu red no tiene salida IPv6 (lo mas comun en hogares/oficinas),
# usa el "Connection Pooler" (Supavisor), que funciona por IPv4:
#
# DATABASE_URL -> pestana "Transaction pooler" (puerto 6543, para la app)
# DIRECT_URL   -> pestana "Session pooler" (puerto 5432, para migraciones)
DATABASE_URL="postgresql://postgres.tu-proyecto:tu-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.tu-proyecto:tu-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"

# URL publica del sitio (usada en el enlace de recuperacion de contrasena)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
